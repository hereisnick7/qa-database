# Postgres credentials — a DB user with SELECT-only grants is strongly
# recommended even though the client also enforces read-only itself
# (see modules/db/client.py).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=replace-me
DB_USER=replace-me
DB_PASSWORD=replace-me

# Optional — client-side safety knobs (defaults shown):
# DB_STATEMENT_TIMEOUT_MS=15000   # abort a query still running after this
# DB_ROW_LIMIT=500                # rows fetched per db-query call unless --limit= overrides

# Optional — SSH bastion tunnel, only needed when the DB isn't directly
# reachable from this machine. Omit all DB_SSH_* keys entirely to connect
# directly to DB_HOST:DB_PORT instead.
# DB_SSH_HOST=bastion.example.com
# DB_SSH_PORT=22
# DB_SSH_USER=replace-me
# DB_SSH_KEY=~/.ssh/id_ed25519
# DB_SSH_KEY_PASSPHRASE=
# DB_REMOTE_HOST=postgres-rw.internal.svc   # host:port as seen FROM the bastion
# DB_REMOTE_PORT=5432

# Multi-account — e.g. separate dev/prod environments selected via
# --account=dev / --account=prod or WORKFLOW_ACCOUNT=prod. Bare keys above
# still work as the 'default' account for single-environment setups.
# DB__DEV__HOST=127.0.0.1
# DB__DEV__PORT=5432
# DB__DEV__NAME=myapp-dev
# DB__DEV__USER=myapp-dev
# DB__DEV__PASSWORD=...
# DB__DEV__SSH_HOST=dev-bastion.example.com
# DB__DEV__SSH_USER=replace-me
# DB__DEV__SSH_KEY=~/.ssh/id_ed25519
# DB__DEV__REMOTE_HOST=postgres-rw.internal.svc
#
# DB__PROD__HOST=127.0.0.1
# DB__PROD__PORT=5432
# DB__PROD__NAME=myapp-prod
# DB__PROD__USER=readonly-prod-user
# DB__PROD__PASSWORD=...
# DB__PROD__SSH_HOST=prod-bastion.example.com
# DB__PROD__SSH_USER=replace-me
# DB__PROD__SSH_KEY=~/.ssh/id_ed25519
# DB__PROD__REMOTE_HOST=10.0.0.5
